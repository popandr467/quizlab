<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Bootstrap CSS (основной) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons (опционально, но красиво) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    
</head>
<body class="bg-light">
    <!-- Навигация -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-journal-bookmark-fill"></i>
                QuizLab
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house"></i> Главная
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/tests/create">
                            <i class="bi bi-plus-circle"></i> Создать тест
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/reports">
                            <i class="bi bi-graph-up"></i> Отчёты
                        </a>
                    </li>
                </ul>
                
                <!-- Пункт с пользователем и аватаром -->
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <!-- <img src="user-sq.png" alt="Avatar" class="rounded-circle" style="width: 2em; height: 2em; object-fit: cover;"> -->
                            <span><%= authData?authData.name:'Вы не авторизованы' %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <% if(authData!==null) { %>
                                <!--<li><a class="dropdown-item" href="/profile">
                                    <i class="bi bi-person"></i> Профиль
                                </a></li>
                                <li><a class="dropdown-item" href="/settings">
                                    <i class="bi bi-gear"></i> Настройки
                                </a></li>
                                <li><hr class="dropdown-divider"></li>-->
                                <li><a class="dropdown-item text-danger" href="/logout">
                                    <i class="bi bi-box-arrow-right"></i> Выйти
                                </a></li>
                            <% } else { %>
                                 <li><a class="dropdown-item" href="/login">
                                    <i class="bi bi-box-arrow-in-right"></i> Войти
                                </a></li>
                                <li><a class="dropdown-item" href="/register">
                                    <i class="bi bi-plus"></i> Зарегистрироваться
                                </a></li>
                            <% } %>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    
    <!-- Основной контент -->
    <main class="container py-4">
        <%- body %>
    </main>
    
    <!-- Bootstrap JS (для интерактивных компонентов) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Глобальные скрипты -->
    <script src="/public/js/utils.js"></script>
    <script src="/public/js/pages/<%# pageScript %>"></script>
</body>
</html>